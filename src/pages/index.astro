    <!-- ======================= Screenshot lightbox ======================= -->
    <div
      id="lightbox"
      style="display: none;"
      class="fixed inset-0 z-[100] cursor-zoom-out items-center justify-center bg-black/90 p-6"
      role="dialog"
      aria-modal="true"
      aria-label="Screenshot preview"
    >
      <button
        id="lightbox-close"
        type="button"
        class="absolute right-5 top-5 rounded-full border border-gray-700 bg-gray-900/80 px-3 py-1.5 text-sm text-gray-300 no-underline transition-colors hover:text-white"
        aria-label="Close preview"
      >Close ✕</button>
      <img id="lightbox-img" src="" alt="" class="max-h-[88vh] max-w-[92vw] cursor-auto rounded-lg border border-gray-800 object-contain shadow-2xl" />
    </div>

    <script>
      // Hero screenshot carousel: crossfade every 5s, dots jump, pause on hover.
      const shots = document.querySelectorAll<HTMLImageElement>('#carousel .shot');
      const dots = document.querySelectorAll<HTMLButtonElement>('.dot');
      const caption = document.getElementById('shot-caption')!;
      const label = document.getElementById('shot-label')!;
      const carousel = document.getElementById('carousel')!;
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function show(i: number) {
        current = i;
        shots.forEach((img, j) => (img.style.opacity = j === i ? '1' : '0'));
        dots.forEach((d, j) => {
          d.style.width = j === i ? '1.5rem' : '0.75rem';
          d.style.background = j === i ? '#6366f1' : '#3f3f46';
        });
        const img = shots[i];
        caption.textContent = img.alt;
        label.textContent = dots[i].getAttribute('aria-label')!.replace('Show ', '');
      }

      function start() {
        timer = setInterval(() => show((current + 1) % shots.length), 5000);
      }

      dots.forEach((d) =>
        d.addEventListener('click', () => {
          clearInterval(timer);
          show(Number(d.dataset.index));
          start();
        })
      );
      carousel.addEventListener('mouseenter', () => clearInterval(timer));
      carousel.addEventListener('mouseleave', start);
      start();

      // Screenshot lightbox: click any screenshot to see it full-size.
      const lightbox = document.getElementById('lightbox')!;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxClose = document.getElementById('lightbox-close')!;

      function openLightbox(src: string, alt: string) {
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.style.display = 'none';
        lightboxImg.src = '';
        document.body.style.overflow = '';
      }

      // Carousel images are stacked absolutely, so open whichever one is
      // currently showing rather than trusting which <img> received the click.
      carousel.addEventListener('click', () => {
        const img = shots[current];
        openLightbox(img.src, img.alt);
      });

      document.querySelectorAll<HTMLImageElement>('img[data-lightbox]').forEach((img) => {
        img.addEventListener('click', () => openLightbox(img.src, img.alt));
      });

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      lightboxClose.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    </script>
  </body>
</html>
